# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Local Anvil deployment artifact (regenerated by script/Deploy.s.sol on every local redeploy;
# addresses are only valid for that specific Anvil run, same rationale as the broadcast logs above)
/deployments/anvil.json

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
