# Copy to .env.local and fill in with your local Anvil deployment's addresses.
# Never commit .env.local.

NEXT_PUBLIC_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN0_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN1_ADDRESS=0x0000000000000000000000000000000000000000

# Optional — defaults shown below match a default `anvil` instance.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
